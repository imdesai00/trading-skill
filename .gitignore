# Your working folder: trades, state, prices. The database and backups are the permanent record.
trader/

# Anything that could hold a secret. Kite keys and access tokens live in
# environment variables or in config you edit yourself, never in this repo.
.env
.env.*
*.env
**/kite*.secret*
**/*access_token*
**/*api_secret*
**/*credentials*
claude_desktop_config.json
.claude/settings.local.json

__pycache__/
*.pyc

# built skill ZIPs (python3 tests/package.py)
dist/

# the local database and its relatives (the whole trader/ folder is ignored above; these catch strays)
*.db
*.db.before-restore
STOP
